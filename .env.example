APP_NAME="ZenWash Auto Care"
APP_ENV=local
APP_KEY=
DANGEROUS_KEY=
APP_DEBUG=true
# DEMO, LIVE, STAGING, or ALL. STAGING uses live routes with a visible warning banner.
# Use ALL for local development and testing.
APP_TYPE=ALL
# The live member portal is under construction; set to true to open it.
MEMBER_PORTAL_ENABLED=false
APP_URL=http://localhost:8000

# Optional subdomain overrides. By default these are derived from APP_URL.
# ADMIN_DOMAIN=admin.carwash-management-system.test
# ADMIN_URL=https://admin.carwash-management-system.test
# MEMBER_DOMAIN=member.carwash-management-system.test
# MEMBER_URL=https://member.carwash-management-system.test
# In DEMO mode, APP_URL is the demo URL and DEMO_DOMAIN/DEMO_URL are ignored.
# DEMO_DOMAIN=demo.carwash-management-system.test
# DEMO_URL=https://demo.carwash-management-system.test

# Fallback only. The live zone lives in app_settings, set from Master > Timezone.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=kencana
AWS_BUCKET=micro-projects-uwnivw
AWS_URL=
AWS_ENDPOINT=https://kencana.basic.bbox.cloudeka.id
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_FOLDER="carwash-management-system"

VITE_APP_NAME="${APP_NAME}"
